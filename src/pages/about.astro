---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';

const WORKS = [
  { title: 'Claude Code 实战手册 v2', desc: '18 章、5 起真实事故复盘，附一个能直接解压进仓库的配置包。免费领。', href: '/handbook/', go: '去领 →' },
  { title: 'pdd.bot', desc: '把给 agent 的要求写成规则文件、skill 和模板。17 个模板可以直接复制。', href: 'https://pdd.bot/zh/', go: '打开 ↗', external: true },
  { title: 'B 站 · 胖胖不胖的AI小岛', desc: '手绘动画讲大模型，还有四门课。', href: 'https://space.bilibili.com/108463642', go: '去看 ↗', external: true },
  { title: '这座 3D 小岛', desc: '首页那座岛，能钓鱼、滑板、拍蚊子。代码开源。', href: 'https://github.com/xiaowuzicode/xiaodao-island', go: '看代码 ↗', external: true },
];
---

<Base title="关于 · 小岛AI">
  <PageHero place="岛主小屋 · ISLAND KEEPER" title="关于岛主" desc="AI Harness 工程师，在创业公司给大模型搭脚手架。" />
  <div class="about-grid">
    <div class="stack">
      <section class="panel">
        <h2 class="panel-h">关于我 <span class="en">ABOUT ME</span></h2>
        <div class="panel-b">
          <p>
            你好，我是「小岛AI」的作者，一名在创业公司做 AI Harness
            的工程师。日常工作是给大模型搭「脚手架」，包括 agent
            的工具链、评测、调度、上下文管理，这些让模型真正能把活干完的工程层。
          </p>
          <p>
            这个站是我公众号文章的开放网络存档。写的东西大体是一类：AI
            行业里正在发生的事，从一个天天看模型在生产环境里怎么跑、怎么翻车的人的视角，聊聊它到底改变了什么。有实测，有踩坑，有判断，偶尔有冷水。
          </p>
          <p>
            想交流、勘误或者合作，写信给我：<a href="mailto:aigc0520@163.com">aigc0520@163.com</a>
          </p>
        </div>
      </section>

      <section class="panel">
        <h2 class="panel-h">我做的东西 <span class="en">WORKS</span></h2>
        <div class="panel-b">
          <ul class="works">
            {
              WORKS.map((w) => (
                <li>
                  <a href={w.href} target={w.external ? '_blank' : undefined} rel={w.external ? 'noopener' : undefined}>
                    <b>{w.title}</b>
                    <i>{w.go}</i>
                    <small>{w.desc}</small>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>

    <div class="stack">
      <section class="panel">
        <h2 class="panel-h">找到我 <span class="en">FOLLOW</span></h2>
        <div class="panel-b">
          <div class="qr-pair">
            <figure>
              <img class="qr" src="/island/wechat-qr.jpg" width="160" height="160" alt="公众号「小岛AI」二维码" loading="lazy" />
              <figcaption>公众号「小岛AI」<br />文章和手册更新</figcaption>
            </figure>
            <figure>
              <img class="qr" src="/handbook/wechat-personal.jpg" width="160" height="160" alt="岛主的微信二维码" loading="lazy" />
              <figcaption>加我微信<br />备注「手册」进资料群</figcaption>
            </figure>
          </div>
          <ul class="kv" style="margin-top: 14px;">
            <li><span>B 站</span> <a href="https://space.bilibili.com/108463642">胖胖不胖的AI小岛 ↗</a></li>
            <li><span>RSS</span> <a href="/rss.xml">/rss.xml ↗</a></li>
            <li><span>给 AI 读</span> <a href="/llms.txt">/llms.txt ↗</a></li>
          </ul>
        </div>
      </section>

      <section class="panel">
        <h2 class="panel-h">为什么有这个站 <span class="en">WHY</span></h2>
        <div class="panel-b">
          <p>
            平台上的内容只有使用权，没有主权。这里是主副本，公众号是分发渠道。顺便，开放的网页才能被搜索引擎和
            AI 检索到，微信生态里的文章不能。
          </p>
        </div>
      </section>
    </div>
  </div>
</Base>

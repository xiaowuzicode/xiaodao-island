---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { postLd } from '@/lib/seo';
import { buildRelated } from '@/lib/related';
import { TOPICS, topicsOf } from '@/lib/topics';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  // 按时间排好，顺手带上相邻两篇（上一篇 / 下一篇）和相关文章
  const related = buildRelated(posts.map((p) => ({ id: p.id, title: p.data.title, summary: p.data.summary })));
  const byId = new Map(posts.map((p) => [p.id, p]));
  // 公众号合集：同系列的篇目按篇序排好，文章页底部列出来
  const seriesOf = (name?: string) => (name ? posts.filter((p) => p.data.series === name).sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0)) : []);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post, newer: posts[i - 1], older: posts[i + 1], series: seriesOf(post.data.series),
      related: (related.get(post.id) ?? []).map((id) => byId.get(id)).filter((p) => p !== undefined),
    },
  }));
}

const { post, newer, older, related, series } = Astro.props;
const topics = topicsOf(post.data.title, post.data.summary).map((s) => TOPICS.find((t) => t.slug === s)).filter((t) => t !== undefined);
const { Content } = await render(post);

function fmt(d: Date) {
  const p = (n: number) => String(n).padStart(2, '0');
  return `${d.getFullYear()} / ${p(d.getMonth() + 1)} / ${p(d.getDate())}`;
}
---

<Base
  title={`${post.data.title} · 小岛AI`}
  description={post.data.summary}
  ogImage={post.data.cover}
  ogType="article"
  publishedTime={post.data.pubDate}
  jsonLd={postLd({ slug: post.id, title: post.data.title, summary: post.data.summary, pubDate: post.data.pubDate, cover: post.data.cover, tags: post.data.tags })}
>
  <article>
    <header class="post-header">
      <p class="crumb"><a href="/">小岛</a> / <a href="/archive/">岛刊社</a> / 文章</p>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <span>小岛AI</span>
        <span class="sep"></span>
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
      </div>
      {post.data.summary && <p class="lede">{post.data.summary}</p>}
      {topics.length > 0 && <p class="chips post-topics">{topics.map((t) => <a href={`/topics/${t.slug}/`}>{t.name}</a>)}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
    {series.length > 1 && (
      <nav class="series panel" aria-labelledby="series-h">
        <h2 id="series-h">{post.data.series} · 共 {series.length} 篇</h2>
        <ol>
          {series.map((p) => (
            <li>{p.id === post.id ? <span aria-current="page">{p.data.title}</span> : <a href={`/posts/${p.id}/`}>{p.data.title}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    <aside class="follow-card panel">
      <p class="title">在微信里读我</p>
      <p>
        这些文章首发于公众号「小岛AI」，搜索即可关注。这里是它们的开放网络存档，欢迎订阅
        <a href="/rss.xml">RSS</a>。
      </p>
    </aside>
    {related.length > 0 && (
      <section class="related" aria-labelledby="related-h">
        <h2 id="related-h">接着读</h2>
        <ul>
          {related.map((r) => (
            <li><a href={`/posts/${r.id}/`}><span>{r.data.title}</span><small>{r.data.summary}</small></a></li>
          ))}
        </ul>
      </section>
    )}
    <nav class="post-nav" aria-label="相邻文章">
      {older && <a href={`/posts/${older.id}/`}><small>上一篇</small>{older.data.title}</a>}
      {newer && <a href={`/posts/${newer.id}/`}><small>下一篇</small>{newer.data.title}</a>}
    </nav>
  </article>
</Base>

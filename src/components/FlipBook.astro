---
import { loadIssues, weekdayZh, CATEGORY_EN, type DailyIssue } from '../lib/daily';

interface Props {
  kicker?: string;
  showIndex?: boolean;
}
const { kicker = '日报翻页册 · 拖动书页翻阅，最新一期在最前', showIndex = true } = Astro.props;

// 最新 9 期做成一本翻页册；第一跨页是最新一期，往后翻回到过去
const issues = loadIssues().slice(0, 9);

function esc(s: string) {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

// CJK 按 1 个单位、ASCII 按 0.54 个单位估宽，做逐行折行
function units(ch: string) {
  return ch.charCodeAt(0) > 0x2e7f ? 1 : 0.54;
}
function wrapText(text: string, maxUnits: number, maxLines: number): string[] {
  const lines: string[] = [];
  let line = '';
  let w = 0;
  for (const ch of text) {
    const u = units(ch);
    if (w + u > maxUnits) {
      lines.push(line);
      if (lines.length === maxLines) {
        lines[maxLines - 1] = lines[maxLines - 1].replace(/.$/, '…');
        return lines;
      }
      line = ch === ' ' ? '' : ch;
      w = ch === ' ' ? 0 : u;
    } else {
      line += ch;
      w += u;
    }
  }
  if (line) lines.push(line);
  return lines;
}
function clip(text: string, maxUnits: number): string {
  let w = 0;
  let out = '';
  for (const ch of text) {
    w += units(ch);
    if (w > maxUnits) return out.replace(/.$/, '') + '…';
    out += ch;
  }
  return out;
}

/* 一期日报 → 一张 1760×1240 的跨页 SVG（书的纸张、装订、内容全部烤进图里）。
   版面比例与翻页引擎的常数捆绑：纸面横向 5.1%–94.9%、纵向 21.8%–78.2%，
   书缝在正中 —— 改这里要连同引擎的 SPAN / --pg 一起改。 */
const SERIF = `Georgia,'Songti SC','Noto Serif SC','STSong','SimSun',serif`;
const INK = '#2a2b2e';
const SOFT = '#6a6d72';
const FAINT = '#9a9c9f';
const CORAL = '#c9532a';
const PAPER = '#fdfaf1';
const EDGE = '#e3d9c6';

function spreadSVG(issue: DailyIssue): string {
  const [y, m, d] = issue.date.split('-');
  const leads = issue.items.slice(0, 3);
  const rest = issue.items.slice(3);
  const restShown = rest.slice(0, 11);
  const restMore = rest.length - restShown.length;

  let t = '';
  // ---------- 左页：报头 + 头版三条 ----------
  const LX = 150; // 左页内容左缘
  let yy = 372;
  t += `<text x="${LX}" y="${yy}" font-size="58" font-weight="700" fill="${INK}">小岛<tspan fill="${CORAL}">AI</tspan> 日报</text>`;
  yy += 44;
  t += `<text x="${LX}" y="${yy}" font-size="20" letter-spacing="3" fill="${SOFT}">总第 ${issue.issueNo} 期 · ${y} 年 ${m} 月 ${d} 日 · ${esc(weekdayZh(issue.date))} · ${issue.items.length} 条信号</text>`;
  yy += 26;
  t += `<rect x="${LX}" y="${yy}" width="640" height="4" fill="${INK}"/>`;
  t += `<rect x="${LX}" y="${yy + 8}" width="640" height="1.5" fill="${INK}"/>`;
  yy += 46;

  for (const it of leads) {
    const cat = esc(it.category);
    const catEn = esc(CATEGORY_EN[it.category] ?? 'SIGNAL');
    t += `<text x="${LX}" y="${yy}" font-size="17" letter-spacing="4" fill="${CORAL}">${catEn} · ${cat}</text>`;
    yy += 36;
    for (const ln of wrapText(it.title, 24.5, 2)) {
      t += `<text x="${LX}" y="${yy}" font-size="27" font-weight="600" fill="${INK}">${esc(ln)}</text>`;
      yy += 37;
    }
    yy += 2;
    const noteLines = wrapText(it.note, 30, 2);
    t += `<rect x="${LX}" y="${yy - 17}" width="4" height="${noteLines.length * 29 - 8}" fill="${CORAL}" opacity=".55"/>`;
    for (const ln of noteLines) {
      t += `<text x="${LX + 16}" y="${yy}" font-size="20" fill="${SOFT}">${esc(ln)}</text>`;
      yy += 29;
    }
    yy += 30;
  }
  t += `<text x="${LX}" y="944" font-size="16" letter-spacing="3" fill="${FAINT}">第 ${issue.issueNo} 页</text>`;

  // ---------- 右页：其余信号精简列表 ----------
  const RX = 946; // 右页内容左缘
  let ry = 372;
  t += `<text x="${RX}" y="${ry}" font-size="20" letter-spacing="5" fill="${SOFT}">更多信号 · MORE SIGNALS</text>`;
  ry += 20;
  t += `<rect x="${RX}" y="${ry}" width="580" height="1.5" fill="${INK}" opacity=".55"/>`;
  ry += 44;
  for (const it of restShown) {
    t += `<circle cx="${RX + 6}" cy="${ry - 7}" r="4" fill="${CORAL}"/>`;
    t += `<text x="${RX + 24}" y="${ry}" font-size="21.5" fill="${INK}">${esc(clip(it.title, 27))}</text>`;
    ry += 40;
  }
  if (restMore > 0) {
    t += `<text x="${RX + 24}" y="${ry}" font-size="19" fill="${FAINT}">……还有 ${restMore} 条，读本期完整版</text>`;
  }
  t += `<text x="${RX}" y="944" font-size="16" letter-spacing="4" fill="${FAINT}">XIAODAO AI DAILY · xiaodao.ai/daily</text>`;

  // ---------- 书本体 ----------
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1760 1240" font-family="${SERIF}">
<defs>
<linearGradient id="gl" x1="0" y1="0" x2="1" y2="0">
  <stop offset="0" stop-color="#3a2c14" stop-opacity="0"/><stop offset="1" stop-color="#3a2c14" stop-opacity=".22"/>
</linearGradient>
<linearGradient id="gr" x1="0" y1="0" x2="1" y2="0">
  <stop offset="0" stop-color="#3a2c14" stop-opacity=".18"/><stop offset="1" stop-color="#3a2c14" stop-opacity="0"/>
</linearGradient>
</defs>
<g>
  <rect x="96" y="282" width="1568" height="694" rx="6" fill="#efe6d2"/>
  <rect x="93" y="278" width="1572" height="694" rx="6" fill="#f6efdd"/>
  <rect x="90" y="270" width="788" height="700" rx="6" fill="${PAPER}" stroke="${EDGE}" stroke-width="2"/>
  <rect x="882" y="270" width="788" height="700" rx="6" fill="${PAPER}" stroke="${EDGE}" stroke-width="2"/>
  <rect x="760" y="270" width="120" height="700" fill="url(#gl)"/>
  <rect x="882" y="270" width="120" height="700" fill="url(#gr)"/>
  <rect x="878" y="270" width="8" height="700" fill="#4a3c26" opacity=".28"/>
  ${t}
</g>
</svg>`;
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
}

const spreads = issues.map((issue) => {
  const [, m, d] = issue.date.split('-');
  return {
    url: spreadSVG(issue),
    title: `总第 ${issue.issueNo} 期 · ${Number(m)} 月 ${Number(d)} 日 · ${weekdayZh(issue.date)}`,
    date: issue.date,
    lead: issue.items[0]?.title ?? '本期简报',
    count: issue.items.length,
    issueNo: issue.issueNo,
  };
});
---

<section class="bk-hero" id="bkHero">
  <p class="bk-kicker">{kicker}</p>

    <div class="bk-wrap" id="bkWrap">
      <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <filter id="bk-mblur-1"><feGaussianBlur stdDeviation="5 0"></feGaussianBlur></filter>
        <filter id="bk-mblur-2"><feGaussianBlur stdDeviation="14 0"></feGaussianBlur></filter>
      </svg>
      <div class="bk-stage" id="bkStage">
        <button class="bk-arrow left" id="bkLeft" aria-label="上一期（更新）">
          <svg viewBox="0 0 14 44" width="14" height="44" fill="none" aria-hidden="true"><polyline points="11,3 3,22 11,41" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="bk-3d" id="bk3d">
          <div class="bk-tilt" id="bkTilt">
            <div class="bk-cast ambient" aria-hidden="true"></div>
            <div class="bk-cast contact" aria-hidden="true"></div>
            <div class="bk-book" id="bkBook"></div>
          </div>
          <div class="zoomwrap" id="zoomWrap" aria-hidden="true"><div class="zoominner" id="zoomInner"></div></div>
          <div class="loupe" id="loupe"><span class="grip"></span><span class="ring"><span class="lens" id="loupeLens"></span></span></div>
        </div>
        <button class="bk-arrow right" id="bkRight" aria-label="下一期（更早）">
          <svg viewBox="0 0 14 44" width="14" height="44" fill="none" aria-hidden="true"><polyline points="3,3 11,22 3,41" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="bk-captions" id="bkCaptions"></div>
      <a class="bk-read" id="bkRead" href="/daily/">读本期完整版 →</a>
      <div class="bk-tools" role="group" aria-label="缩放">
        <button class="tool" id="zOut" aria-label="缩小"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="8.6" cy="8.6" r="5.6"/><path d="M12.8 12.8 17.4 17.4M6.2 8.6h4.8"/></svg></button>
        <span class="zoom-read" id="zRead">100%</span>
        <button class="tool" id="zIn" aria-label="放大"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="8.6" cy="8.6" r="5.6"/><path d="M12.8 12.8 17.4 17.4M6.2 8.6h4.8M8.6 6.2v4.8"/></svg></button>
        <span class="tool-sep" aria-hidden="true"></span>
        <button class="tool" id="loupeBtn" aria-label="放大镜" aria-pressed="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="8.8" cy="8.8" r="5.8"/><path d="M13 13l4.4 4.4"/><path d="M6.4 7.2a3.2 3.2 0 0 1 2.4-1.4" opacity=".55"/></svg></button>
      </div>
      <p class="bk-hint" id="bkHint">拖动书页翻阅 · 拖动放大镜细看 · ← → 方向键</p>
  </div>
</section>

{
  showIndex && (
    <section class="bk-plates">
      <p class="bk-label">册内九期</p>
      <ol class="bk-plate-list" id="bkPlateList" />
      <p class="bk-foot">
        <a href="/daily/">看全部归档 →</a>
      </p>
    </section>
  )
}

<style is:global>
  .bk-hero {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    display: grid;
    justify-items: center;
    align-content: start;
    padding: clamp(18px, 3vh, 40px) 0 clamp(28px, 4vh, 56px);
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 50% 12%, rgba(233, 98, 51, 0.05), transparent 70%),
      radial-gradient(50% 45% at 12% 85%, rgba(34, 58, 94, 0.05), transparent 70%);
  }
  .bk-hero,
  .bk-hero * {
    -webkit-user-select: none;
    user-select: none;
  }
  .bk-kicker {
    font-size: 12px;
    letter-spacing: 0.22em;
    color: var(--muted);
    margin: 0 0 clamp(14px, 2.4vh, 28px);
  }
  .bk-wrap {
    display: grid;
    justify-items: center;
    gap: 14px;
    width: 100%;
    position: relative;
  }
  .bk-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    position: relative;
    touch-action: pan-y;
  }
  .bk-arrow {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 2px;
    border: 0;
    background: transparent;
    color: var(--faint);
    cursor: pointer;
    transition: color 0.2s;
    -webkit-tap-highlight-color: transparent;
    z-index: 8;
  }
  .bk-arrow:hover {
    color: var(--ink);
  }
  .bk-3d {
    position: relative;
    flex: 1 1;
    min-width: 0;
    max-width: 1100px;
    perspective: 1750px;
    perspective-origin: 50% 46%;
  }
  .bk-tilt {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(var(--zoom, 1));
    will-change: transform;
  }
  .bk-book {
    position: relative;
    width: 100%;
    aspect-ratio: 1760/1240;
    transform-style: preserve-3d;
    z-index: 1;
  }
  .bk-book img {
    -webkit-user-drag: none;
  }
  .bk-cast {
    position: absolute;
    pointer-events: none;
    z-index: 0;
  }
  .bk-cast.ambient {
    left: 5%;
    right: 5%;
    top: 27%;
    bottom: 2%;
    background: radial-gradient(
      50% 50% at 50% 58%,
      rgba(58, 44, 26, 0.3) 0%,
      rgba(58, 44, 26, 0.16) 40%,
      rgba(58, 44, 26, 0) 74%
    );
    filter: blur(26px);
    opacity: calc(1 - var(--shade, 0) * 0.42);
  }
  .bk-cast.contact {
    left: 9%;
    right: 9%;
    top: 62%;
    bottom: 10%;
    background: radial-gradient(
      50% 44% at 50% 42%,
      rgba(44, 32, 14, 0.34) 0%,
      rgba(44, 32, 14, 0.14) 48%,
      rgba(44, 32, 14, 0) 78%
    );
    filter: blur(11px);
    opacity: calc(1 - var(--shade, 0) * 0.5);
  }
  .bk-full {
    position: absolute;
    inset: 0;
  }
  .bk-full img {
    width: 100%;
    height: auto;
    display: block;
  }
  .bk-half {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow-x: clip;
    overflow-y: visible;
  }
  .bk-half.left {
    left: 0;
  }
  .bk-half.right {
    left: 50%;
  }
  .bk-half-img {
    width: 200%;
    max-width: none;
    height: auto;
    display: block;
  }
  .bk-half-img.right {
    margin-left: -100%;
  }
  .gutter-shade {
    position: absolute;
    top: var(--pg, 21.8%);
    bottom: var(--pg, 21.8%);
    width: 46%;
    pointer-events: none;
    opacity: calc(var(--shade, 0) * 0.62);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 5.2%, #000 94.8%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 5.2%, #000 94.8%, transparent 100%);
  }
  .gutter-shade.left {
    right: 0;
    background: linear-gradient(270deg, rgba(52, 38, 20, 0.3), rgba(52, 38, 20, 0) 82%);
  }
  .gutter-shade.right {
    left: 0;
    background: linear-gradient(90deg, rgba(52, 38, 20, 0.24), rgba(52, 38, 20, 0) 82%);
  }
  /* 翻动的书页：嵌套窄条链拼出的弯曲面（几何来自 MengTo/sketchbook） */
  .curl {
    position: absolute;
    top: 0;
    height: 100%;
    width: calc(var(--bw, 0px) * var(--span));
    transform-style: preserve-3d;
    z-index: 6;
  }
  .curl.next {
    left: 50%;
    transform-origin: left center;
    transform: rotateY(calc(-1 * var(--tt, 0deg)));
  }
  .curl.prev {
    right: 50%;
    transform-origin: right center;
    transform: rotateY(var(--tt, 0deg));
  }
  .strip {
    position: absolute;
    top: 0;
    height: 100%;
    width: calc(var(--bw, 0px) * var(--span) / var(--n));
    transform-style: preserve-3d;
  }
  .curl.next .strip {
    transform-origin: left center;
  }
  .curl.prev .strip {
    transform-origin: right center;
  }
  .curl.next > .strip {
    left: 0;
  }
  .curl.prev > .strip {
    right: 0;
    left: auto;
  }
  .curl.next .strip .strip {
    left: 100%;
    transform: rotateY(var(--td, 0deg));
  }
  .curl.prev .strip .strip {
    right: 100%;
    transform: rotateY(calc(-1 * var(--td, 0deg)));
  }
  .face {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: -1.1px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background-repeat: no-repeat;
    background-size: var(--bw, 0px) auto;
  }
  .face.back {
    transform: rotateY(180deg);
  }
  .face .sh,
  .face .gl {
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 5.2%, #000 94.8%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 5.2%, #000 94.8%, transparent 100%);
  }
  .strip.edge .face .sh,
  .strip.edge .face .gl {
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 9%, #000 91%, transparent 100%), var(--hf);
    mask-image: linear-gradient(180deg, transparent 0, #000 9%, #000 91%, transparent 100%), var(--hf);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  .curl.next .strip.edge .face.front,
  .curl.prev .strip.edge .face.back {
    --hf: linear-gradient(90deg, #000 0 22%, transparent 96%);
  }
  .curl.next .strip.edge .face.back,
  .curl.prev .strip.edge .face.front {
    --hf: linear-gradient(270deg, #000 0 22%, transparent 96%);
  }
  .face .sh {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--pg, 21.8%);
    bottom: var(--pg, 21.8%);
    pointer-events: none;
  }
  .curl.next .face.front .sh,
  .curl.prev .face.back .sh {
    background: linear-gradient(90deg, rgba(58, 43, 20, var(--a1, 0)), rgba(58, 43, 20, var(--a2, 0)));
  }
  .curl.next .face.back .sh,
  .curl.prev .face.front .sh {
    background: linear-gradient(90deg, rgba(58, 43, 20, var(--a2, 0)), rgba(58, 43, 20, var(--a1, 0)));
  }
  .face .gl {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--pg, 21.8%);
    bottom: var(--pg, 21.8%);
    pointer-events: none;
    background: #fffaf0;
    opacity: calc(var(--shade, 0) * var(--lit, 1) * var(--lit, 1) * 0.2);
  }
  .bk-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    border: 0;
    background: transparent;
    cursor: grab;
    z-index: 60;
    -webkit-tap-highlight-color: transparent;
  }
  .bk-zone:active {
    cursor: grabbing;
  }
  .bk-prev {
    left: 0;
    width: 50%;
  }
  .bk-next {
    right: 0;
    width: 50%;
  }
  .bk-captions {
    display: grid;
    justify-items: center;
    min-height: 22px;
  }
  .bk-captions > * {
    grid-area: 1/1;
    margin: 0;
  }
  .bk-caption {
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--body);
    animation: bk-cap-in 0.5s ease both;
  }
  .bk-caption.live {
    animation: none;
  }
  @keyframes bk-cap-in {
    0% {
      opacity: 0;
    }
  }
  .bk-read {
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--coral-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .bk-read:hover {
    border-color: var(--coral-text);
  }
  .bk-tools {
    display: flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 7px;
    background: var(--surface);
  }
  .bk-tools .tool {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .bk-tools .tool:hover {
    background: var(--card);
    color: var(--ink);
  }
  .bk-tools .tool:disabled {
    opacity: 0.32;
    cursor: default;
    background: transparent;
  }
  .bk-tools .tool svg {
    width: 15px;
    height: 15px;
    display: block;
  }
  .zoom-read {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--faint);
    min-width: 40px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .tool-sep {
    width: 1px;
    height: 17px;
    background: var(--line);
    margin: 0 2px;
  }
  .bk-tools .tool[aria-pressed='true'] {
    background: rgba(201, 83, 42, 0.14);
    color: var(--coral-text);
  }
  /* 放大镜：真躺在纸面上的一枚铜圈镜。镜片下藏一份书的副本，
     按镜心所在的页面点放大并圆形遮罩；它挂在倾斜变换之外，
     所以书倾斜时镜子纹丝不动。 */
  .loupe {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--lr, 270px);
    height: var(--lr, 270px);
    pointer-events: none;
    z-index: 80;
    opacity: 0;
    transition: opacity 0.25s ease;
    will-change: transform;
  }
  .loupe.on {
    opacity: 1;
  }
  .loupe.held .ring {
    cursor: grabbing;
  }
  .loupe .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: auto;
    cursor: grab;
    padding: calc(var(--lr, 270px) * 0.058);
    box-shadow:
      0 1px 2px rgba(58, 44, 26, 0.3),
      0 10px 18px rgba(58, 44, 26, 0.24),
      0 26px 40px rgba(58, 44, 26, 0.2),
      0 48px 66px rgba(58, 44, 26, 0.13);
  }
  .loupe .ring:before {

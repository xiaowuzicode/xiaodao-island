---
/** 内页（文章、日报、存档、关于）的公共骨架：和 3D 小岛首页同一套软陶 · 海岛色视觉。 */
import '@/styles/global.css';
import Logo from '@/components/Logo.astro';
import Analytics from '@/components/Analytics.astro';
import { ldJson } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** 文章页传 article（并带发布时间），其余页面默认 website。 */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  /** 给搜索引擎的结构化数据（见 lib/seo.ts）。 */
  jsonLd?: unknown;
}

const {
  title = '小岛AI · AI 航行日志',
  description = '一个给 AI 搭脚手架的工程师，记录一线实战、踩坑与判断。',
  ogImage,
  ogType = 'website',
  publishedTime,
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

const NAV = [
  { key: 1, href: '/', label: '小岛', match: (p: string) => p === '/' },
  { key: 2, href: '/videos/', label: '视频', match: (p: string) => p.startsWith('/videos/') },
  { key: 3, href: '/archive/', label: '文章', match: (p: string) => p.startsWith('/archive/') || p.startsWith('/posts/') },
  { key: 4, href: '/daily/', label: '日报', match: (p: string) => p.startsWith('/daily/') && !p.startsWith('/daily/book') },
  { key: 5, href: '/daily/book/', label: '翻页册', match: (p: string) => p.startsWith('/daily/book') },
  { key: 6, href: '/about/', label: '关于', match: (p: string) => p.startsWith('/about/') },
  { key: 7, href: '/rss.xml', label: 'RSS', match: () => false },
];
// 分享卡片：文章有封面就用封面，没有就用小岛的 JPG 分享图（部分平台不认 WebP）
const og = new URL(ogImage ?? '/island/og.jpg', Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1b2c" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="小岛AI" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="小岛AI" />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd !== undefined && <script type="application/ld+json" set:html={ldJson(jsonLd)} />}
    <meta name="generator" content={Astro.generator} />
    <Analytics />
  </head>
  <body>
    <header class="site-top">
      <a href="/" class="brand" aria-label="小岛AI，回到 3D 小岛">
        <Logo />
        <span><b>小岛AI</b><small>AI 航行日志</small></span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        {NAV.map((n) => (
          <a href={n.href} data-key={n.key} aria-current={n.match(path) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    <main class="main">
      <slot />
    </main>

    <footer class="site-foot">
      <a class="foot-island" href="/">
        <img src="/island/poster-wide.webp" alt="" width="1600" height="1000" loading="lazy" decoding="async" />
        <span><b>回到小岛</b><small>灯塔、岛刊社、船坞和两座小岛都在那儿</small></span>
      </a>
      <p>© {new Date().getFullYear()} 小岛AI · 记录一线实战、踩坑与判断 · <a href="/topics/">专题</a> · <a href="/rss.xml">RSS</a> · <a href="/llms.txt">llms.txt</a></p>
    </footer>

    <script>
      // 数字键 1-7 跳到对应栏目（输入框里不拦截）
      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target as HTMLElement | null;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
        const a = document.querySelector<HTMLAnchorElement>(`.site-nav a[data-key="${e.key}"]`);
        if (a) location.href = a.href;
      });
    </script>
  </body>
</html>
